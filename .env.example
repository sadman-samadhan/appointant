# Server-only credentials used to read the public service menu for the homepage.
# Use a dedicated low-privilege account (NOT the owner account). Never prefix with NEXT_PUBLIC_.
CATALOG_USERID=
CATALOG_PASSWORD=

# Optional backend overrides (defaults point at the shared dev servers)
# AUTH_BACKEND_URL=http://3.6.123.11:3302
# CORE_BACKEND_URL=http://3.6.123.11:3301

# Optional: the shop's branch (defaults to Downtown Main Branch)
# NEXT_PUBLIC_BRANCH_ID=065f43af-56ad-4ce3-91f3-436f024493a7

# Optional: customers served at the same time (default 3)
# NEXT_PUBLIC_SHOP_CAPACITY=3

# Customer self-booking in this app (keep false until the Auth Service issues real tenants)
# NEXT_PUBLIC_ONLINE_BOOKING=false
