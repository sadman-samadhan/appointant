# Server-only credentials used to read the public service menu for the homepage.
# Optional: if empty, the BOOKING_AGENT_* account below is used. Never prefix with NEXT_PUBLIC_.
CATALOG_USERID=
CATALOG_PASSWORD=

# Optional backend overrides (defaults point at the shared dev servers)
# AUTH_BACKEND_URL=http://3.6.123.11:3302
# CORE_BACKEND_URL=http://3.6.123.11:3301

# Optional: the shop's branch (defaults to Downtown Main Branch)
# NEXT_PUBLIC_BRANCH_ID=065f43af-56ad-4ce3-91f3-436f024493a7

# Optional: customers served at the same time, i.e. chairs/barbers (default 2).
# A time can't be booked once this many appointments (of any service) overlap it.
# NEXT_PUBLIC_SHOP_CAPACITY=2


# Server-only account that places online bookings for guests (must be able to manage the
# shop: today only the owner can). Falls back to CATALOG_USERID / CATALOG_PASSWORD.
BOOKING_AGENT_USERID=
BOOKING_AGENT_PASSWORD=

# Online booking limit of 5 bookings/hour per device. Off while testing; set to true at launch.
# (Phone numbers are always checked: 10 digits, shown as (506)-555-1234.)
# BOOKING_STRICT_CHECKS=true

# Emails to customers (booking confirmation with a calendar invite, moves, cancellations).
# Server-only. Without them, no email is sent. Use the mail server's own host name (it
# matches its security certificate); 465 = SSL, 587 = STARTTLS.
# SMTP_HOST=premium180.web-hosting.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="B Diamond Barbershop <you@example.com>"

# Signs the sign-up email codes (any long random text). Falls back to BOOKING_AGENT_PASSWORD.
SIGNUP_CODE_SECRET=
